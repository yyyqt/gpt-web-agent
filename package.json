{
  "name": "gpt-web-agent",
  "version": "0.6.0",
  "description": "A local MCP tool runtime for browser-based AI agents. No model proxy or inference API required by the runtime.",
  "keywords": [
    "chatgpt",
    "mcp",
    "agent",
    "local-tools",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyqt/gpt-web-agent.git"
  },
  "homepage": "https://github.com/yyyqt/gpt-web-agent#readme",
  "bugs": "https://github.com/yyyqt/gpt-web-agent/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gpt-web-agent": "src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE",
    "test",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/cli.js && node --check src/runtime.js && node --check src/server.js && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  }
}
